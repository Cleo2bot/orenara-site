# Email notifications via Resend (https://resend.com)
# Create a free account, verify your domain, and paste the API key here.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email address that receives enquiry notifications
ADMIN_NOTIFICATION_EMAIL=hello@duskline.com.au

# The "from" address for notification emails (must be from a verified Resend domain)
RESEND_FROM_EMAIL=enquiries@duskline.com.au
