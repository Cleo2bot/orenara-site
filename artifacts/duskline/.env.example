# Email notifications via Resend (https://resend.com)
# Create a free account, verify your domain, and paste the API key here.
# NOTE: Email domain intentionally orenara.com (Resend-verified); site canonical is orenara.com.au.
# DNS + Resend domain verification for orenara.com must be completed manually before go-live.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email address that receives enquiry notifications
ADMIN_NOTIFICATION_EMAIL=hello@orenara.com

# The "from" address for notification emails (must be from a verified Resend domain)
RESEND_FROM_EMAIL=enquiries@orenara.com

# Google Ads conversion tracking — values from Google Ads > Goals > Conversions > tag setup
# > "Use Google tag" > shows the Conversion ID (AW-XXXXXXXXXX) and per-conversion Labels.
# Leave unset until the Ads account is created; tracking is silently disabled when unset.
NEXT_PUBLIC_GOOGLE_ADS_ID=            # format: AW-XXXXXXXXXX  (the Conversion ID, shared across all conversions)
NEXT_PUBLIC_CONV_LABEL_ENQUIRY=       # conversion label for main enquiry form submission
NEXT_PUBLIC_CONV_LABEL_TRADE=         # conversion label for trade enquiry form submission
NEXT_PUBLIC_CONV_LABEL_QUOTE=         # conversion label for quote builder submission
