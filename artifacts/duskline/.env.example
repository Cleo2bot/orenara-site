# Email notifications via Resend (https://resend.com)
# Create a free account, verify your domain, and paste the API key here.
# NOTE: Email domain intentionally orenara.com (Resend-verified); site canonical is orenara.com.au.
# DNS + Resend domain verification for orenara.com must be completed manually before go-live.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email address that receives enquiry notifications
ADMIN_NOTIFICATION_EMAIL=hello@orenara.com

# The "from" address for notification emails (must be from a verified Resend domain)
RESEND_FROM_EMAIL=enquiries@orenara.com
